config BR2_PACKAGE_DASHBOARD_PI_WPEWEBKIT
	bool "Dashboard Pi WPE WebKit"
	depends on BR2_PACKAGE_WPEWEBKIT_ARCH_SUPPORTS
	depends on !BR2_BINFMT_FLAT
	depends on !BR2_STATIC_LIBS
	depends on BR2_HOST_GCC_AT_LEAST_7
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_11
	depends on BR2_USE_WCHAR
	depends on BR2_PACKAGE_HAS_LIBGLES
	depends on BR2_PACKAGE_HAS_LIBEGL
	depends on BR2_PACKAGE_HAS_LIBGBM
	depends on BR2_PACKAGE_HAS_UDEV
	depends on !BR2_PACKAGE_WPEWEBKIT
	select BR2_HOST_CMAKE_AT_LEAST_3_20
	select BR2_PACKAGE_FONTCONFIG
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_HARFBUZZ
	select BR2_PACKAGE_ICU
	select BR2_PACKAGE_JPEG
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_LIBEPOXY
	select BR2_PACKAGE_LIBGCRYPT
	select BR2_PACKAGE_LIBINPUT
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_LIBSOUP3
	select BR2_PACKAGE_LIBTASN1
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_LIBXSLT
	select BR2_PACKAGE_WEBP
	select BR2_PACKAGE_WEBP_DEMUX
	select BR2_PACKAGE_WEBP_MUX
	help
	  Build the pinned WPE WebKit release used by Dashboard Pi.
	  It includes WPEPlatform DRM/KMS and headless implementations.
	  The legacy libwpe API, wpebackend-fdo, Wayland display backend
	  and Cog are disabled.

	  This is separate from Buildroot's wpewebkit package because
	  Buildroot 2026.05 ships WPE WebKit 2.50 with the legacy API.

	  https://wpewebkit.org/

comment "Dashboard Pi WPE WebKit needs C++, wchar, NPTL, dynamic libraries, gcc >= 11 and host gcc >= 7"
	depends on BR2_PACKAGE_WPEWEBKIT_ARCH_SUPPORTS
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_USE_WCHAR \
		|| !BR2_TOOLCHAIN_HAS_THREADS_NPTL || BR2_STATIC_LIBS \
		|| !BR2_TOOLCHAIN_GCC_AT_LEAST_11 \
		|| !BR2_HOST_GCC_AT_LEAST_7

comment "Dashboard Pi WPE WebKit needs EGL, GLES, GBM and udev"
	depends on BR2_PACKAGE_WPEWEBKIT_ARCH_SUPPORTS
	depends on !BR2_PACKAGE_HAS_LIBGLES || !BR2_PACKAGE_HAS_LIBEGL \
		|| !BR2_PACKAGE_HAS_LIBGBM || !BR2_PACKAGE_HAS_UDEV
