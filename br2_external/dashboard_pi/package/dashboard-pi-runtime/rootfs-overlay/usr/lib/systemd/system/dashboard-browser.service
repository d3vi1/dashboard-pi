[Unit]
Description=Dashboard WPEPlatform runtime
After=dashboard-url.service
Requires=dashboard-url.service
StartLimitIntervalSec=30
StartLimitBurst=6

[Service]
Type=simple
User=dashboard
Group=dashboard
SupplementaryGroups=video input render
RuntimeDirectory=dashboard-pi
RuntimeDirectoryMode=0755
EnvironmentFile=/run/dashboard-pi/url.env
Environment=XDG_RUNTIME_DIR=/run/dashboard-pi
Environment=XDG_CACHE_HOME=/run/dashboard-pi/cache
Environment=HOME=/run/dashboard-pi/home
ExecStart=/usr/bin/dashboard-wpeplatform-launch
Restart=always
RestartSec=750ms
TimeoutStartSec=8s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/dashboard-pi

[Install]
WantedBy=dashboard.target
