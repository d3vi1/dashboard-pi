#!/bin/sh
set -eu

: "${DASHBOARD_URL:=file:///usr/share/dashboard-pi/error.html}"

mkdir -p "${XDG_CACHE_HOME:-/run/dashboard-pi/cache}" "${HOME:-/run/dashboard-pi/home}"

log() {
	printf '%s\n' "dashboard-wpeplatform-launch: $*" >&2
}

if command -v dashboard-pi-launcher >/dev/null 2>&1; then
	log "starting Dashboard Pi WPEPlatform launcher for $DASHBOARD_URL"
	exec dashboard-pi-launcher "$DASHBOARD_URL"
fi

log "dashboard-pi-launcher is not installed"
exit 127
